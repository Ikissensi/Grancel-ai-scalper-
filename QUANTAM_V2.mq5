//+------------------------------------------------------------------+
//| GRANCEL QUANTAM V2 - BTCUSD MT5 Expert Advisor                   |
//+------------------------------------------------------------------+
#property strict
#property version "2.00"
#property description "BTCUSD auto scanner/trader with risk sizing and dashboard"
#include <Trade/Trade.mqh>
CTrade trade;
input string InpSymbol="BTCUSD"; // Set broker symbol exactly, e.g. BTCUSDm
input ENUM_TIMEFRAMES InpTF=PERIOD_M5;
input bool InpEnableTrading=false; // Enable only after demo testing
input double InpVirtualStartBalance=50.00; // V2-only capital allocation\ninput double InpRiskPercent=0.50;
input int InpMaxPositions=3;
input ulong InpMagic=24112402;
input int InpFastEMA=20,InpMidEMA=50,InpSlowEMA=200,InpRSI=14,InpATR=14;
input double InpBuyRSI=52,InpSellRSI=48,InpSL_ATR=1.5,InpTP_RR=2.0;
int hf,hm,hs,hr,ha; datetime lastBar=0; double peak=0,maxDD=0;
string P="QTV2_";
bool Val(int h,double &v){double a[];ArraySetAsSeries(a,true);if(CopyBuffer(h,0,1,1,a)!=1)return false;v=a[0];return MathIsValidNumber(v);}
int PosCount(){int n=0;for(int i=PositionsTotal()-1;i>=0;i--){ulong t=PositionGetTicket(i);if(t>0&&PositionGetString(POSITION_SYMBOL)==InpSymbol&&(ulong)PositionGetInteger(POSITION_MAGIC)==InpMagic)n++;}return n;}
double FloatPL(){double v=0;for(int i=PositionsTotal()-1;i>=0;i--){ulong t=PositionGetTicket(i);if(t>0&&PositionGetString(POSITION_SYMBOL)==InpSymbol&&(ulong)PositionGetInteger(POSITION_MAGIC)==InpMagic)v+=PositionGetDouble(POSITION_PROFIT)+PositionGetDouble(POSITION_SWAP);}return v;}
double V2RealizedPL(){double p=0;if(HistorySelect(0,TimeCurrent()))for(int i=0;i<HistoryDealsTotal();i++){ulong d=HistoryDealGetTicket(i);if(d>0&&HistoryDealGetString(d,DEAL_SYMBOL)==InpSymbol&&(ulong)HistoryDealGetInteger(d,DEAL_MAGIC)==InpMagic&&(ENUM_DEAL_ENTRY)HistoryDealGetInteger(d,DEAL_ENTRY)==DEAL_ENTRY_OUT)p+=HistoryDealGetDouble(d,DEAL_PROFIT)+HistoryDealGetDouble(d,DEAL_SWAP)+HistoryDealGetDouble(d,DEAL_COMMISSION);}return p;}
double Lots(double dist){double allocated=MathMax(0,InpVirtualStartBalance+V2RealizedPL()+FloatPL());double risk=allocated*InpRiskPercent/100.0,ts=SymbolInfoDouble(InpSymbol,SYMBOL_TRADE_TICK_SIZE),tv=SymbolInfoDouble(InpSymbol,SYMBOL_TRADE_TICK_VALUE_LOSS);if(tv<=0)tv=SymbolInfoDouble(InpSymbol,SYMBOL_TRADE_TICK_VALUE);if(ts<=0||tv<=0||dist<=0)return 0;double step=SymbolInfoDouble(InpSymbol,SYMBOL_VOLUME_STEP),mn=SymbolInfoDouble(InpSymbol,SYMBOL_VOLUME_MIN),mx=SymbolInfoDouble(InpSymbol,SYMBOL_VOLUME_MAX);double x=MathFloor((risk/((dist/ts)*tv))/step)*step;if(x<mn)return 0;return MathMin(x,mx);}
void Label(string n,int y,string s,color c,int size=9){string id=P+n;if(ObjectFind(0,id)<0)ObjectCreate(0,id,OBJ_LABEL,0,0,0);ObjectSetInteger(0,id,OBJPROP_CORNER,CORNER_LEFT_UPPER);ObjectSetInteger(0,id,OBJPROP_XDISTANCE,12);ObjectSetInteger(0,id,OBJPROP_YDISTANCE,y);ObjectSetInteger(0,id,OBJPROP_COLOR,c);ObjectSetInteger(0,id,OBJPROP_FONTSIZE,size);ObjectSetString(0,id,OBJPROP_TEXT,s);}
void Dashboard(){double f=FloatPL(),b=InpVirtualStartBalance+V2RealizedPL(),e=b+f;if(peak<=0)peak=e;if(e>peak)peak=e;double dd=peak>0?(peak-e)/peak*100:0;if(dd>maxDD)maxDD=dd;int n=0,w=0,l=0;double net=0;if(HistorySelect(0,TimeCurrent()))for(int i=HistoryDealsTotal()-1;i>=0;i--){ulong d=HistoryDealGetTicket(i);if(!d||HistoryDealGetString(d,DEAL_SYMBOL)!=InpSymbol||(ulong)HistoryDealGetInteger(d,DEAL_MAGIC)!=InpMagic||(ENUM_DEAL_ENTRY)HistoryDealGetInteger(d,DEAL_ENTRY)!=DEAL_ENTRY_OUT)continue;double p=HistoryDealGetDouble(d,DEAL_PROFIT)+HistoryDealGetDouble(d,DEAL_SWAP)+HistoryDealGetDouble(d,DEAL_COMMISSION);n++;net+=p;if(p>0)w++;else l++;}Label("title",12,"GRANCEL | QUANTAM V2 | "+InpSymbol,clrGold,13);Label("mode",36,InpEnableTrading?"AUTO TRADING ENABLED":"SAFE MODE - SIGNALS ONLY",InpEnableTrading?clrLime:clrOrange);Label("bal",58,"V2 ALLOCATED BAL "+DoubleToString(b,2)+" | V2 EQUITY "+DoubleToString(e,2),clrWhite);Label("float",80,"FLOATING P/L "+DoubleToString(f,2),f>=0?clrLime:clrTomato);Label("pos",102,"OPEN POSITIONS "+IntegerToString(PosCount())+" / "+IntegerToString(InpMaxPositions),clrWhite);Label("stats",124,"CLOSED "+IntegerToString(n)+" | W "+IntegerToString(w)+" | L "+IntegerToString(l)+" | WR "+DoubleToString(n?100.0*w/n:0,1)+"%",clrWhite);Label("net",146,"NET "+DoubleToString(net,2)+" | MAX DD "+DoubleToString(maxDD,2)+"%",net>=0?clrLime:clrTomato);Label("curve",174,"EQUITY TRACKER: GREEN = positive floating P/L; RED = negative",clrSilver,8);string bar=P+"bar";if(ObjectFind(0,bar)<0)ObjectCreate(0,bar,OBJ_RECTANGLE_LABEL,0,0,0);ObjectSetInteger(0,bar,OBJPROP_CORNER,CORNER_LEFT_UPPER);ObjectSetInteger(0,bar,OBJPROP_XDISTANCE,12);ObjectSetInteger(0,bar,OBJPROP_YDISTANCE,194);ObjectSetInteger(0,bar,OBJPROP_XSIZE,(int)MathMax(4,MathMin(260,MathAbs(f)*5+4)));ObjectSetInteger(0,bar,OBJPROP_YSIZE,10);ObjectSetInteger(0,bar,OBJPROP_BGCOLOR,f>=0?clrLime:clrTomato);ObjectSetInteger(0,bar,OBJPROP_COLOR,f>=0?clrLime:clrTomato);}
void TradeSignal(){double a,b,c,r,atr;if(!Val(hf,a)||!Val(hm,b)||!Val(hs,c)||!Val(hr,r)||!Val(ha,atr))return;double close=iClose(InpSymbol,InpTF,1);bool buy=a>b&&b>c&&close>c&&r>=InpBuyRSI,sell=a<b&&b<c&&close<c&&r<=InpSellRSI;string sig=buy?"BUY":sell?"SELL":"WAIT";Label("signal",218,"SIGNAL "+sig+" | RSI "+DoubleToString(r,1),buy?clrLime:sell?clrTomato:clrSilver);if(!InpEnableTrading||(!buy&&!sell))return;ENUM_POSITION_TYPE wanted=buy?POSITION_TYPE_BUY:POSITION_TYPE_SELL;for(int i=PositionsTotal()-1;i>=0;i--){ulong t=PositionGetTicket(i);if(t>0&&PositionGetString(POSITION_SYMBOL)==InpSymbol&&(ulong)PositionGetInteger(POSITION_MAGIC)==InpMagic&&(ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE)!=wanted)trade.PositionClose(t);}if(PosCount()>=InpMaxPositions)return;MqlTick q;if(!SymbolInfoTick(InpSymbol,q))return;double entry=buy?q.ask:q.bid,dist=atr*InpSL_ATR,sl=buy?entry-dist:entry+dist,tp=buy?entry+dist*InpTP_RR:entry-dist*InpTP_RR,lot=Lots(dist);if(lot<=0){Label("status",240,"SKIPPED: broker min lot exceeds risk budget",clrOrange,8);return;}int dg=(int)SymbolInfoInteger(InpSymbol,SYMBOL_DIGITS);trade.SetExpertMagicNumber(InpMagic);trade.SetTypeFillingBySymbol(InpSymbol);bool ok=buy?trade.Buy(lot,InpSymbol,0,NormalizeDouble(sl,dg),NormalizeDouble(tp,dg),"QUANTAM V2 BUY"):trade.Sell(lot,InpSymbol,0,NormalizeDouble(sl,dg),NormalizeDouble(tp,dg),"QUANTAM V2 SELL");Label("status",240,ok?"ORDER SENT "+sig+" "+DoubleToString(lot,2):"ORDER FAILED "+trade.ResultRetcodeDescription(),ok?clrLime:clrTomato,8);}
int OnInit(){if(!SymbolSelect(InpSymbol,true))return INIT_FAILED;hf=iMA(InpSymbol,InpTF,InpFastEMA,0,MODE_EMA,PRICE_CLOSE);hm=iMA(InpSymbol,InpTF,InpMidEMA,0,MODE_EMA,PRICE_CLOSE);hs=iMA(InpSymbol,InpTF,InpSlowEMA,0,MODE_EMA,PRICE_CLOSE);hr=iRSI(InpSymbol,InpTF,InpRSI,PRICE_CLOSE);ha=iATR(InpSymbol,InpTF,InpATR);if(hf==INVALID_HANDLE||hm==INVALID_HANDLE||hs==INVALID_HANDLE||hr==INVALID_HANDLE||ha==INVALID_HANDLE)return INIT_FAILED;trade.SetExpertMagicNumber(InpMagic);peak=AccountInfoDouble(ACCOUNT_EQUITY);EventSetTimer(2);Dashboard();return INIT_SUCCEEDED;}
void OnDeinit(const int r){EventKillTimer();IndicatorRelease(hf);IndicatorRelease(hm);IndicatorRelease(hs);IndicatorRelease(hr);IndicatorRelease(ha);ObjectsDeleteAll(0,P);}
void OnTick(){datetime t=iTime(InpSymbol,InpTF,0);if(t>0&&t!=lastBar){lastBar=t;TradeSignal();}}
void OnTimer(){Dashboard();ChartRedraw();}
